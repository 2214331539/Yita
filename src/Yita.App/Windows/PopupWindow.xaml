<Window x:Class="Yita.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Yita.Windows"
        x:ClassModifier="internal"
        WindowStyle="None"
        ResizeMode="CanResize"
        SizeToContent="WidthAndHeight"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        FontFamily="{DynamicResource InterfaceFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SizeChanged="PopupWindow_SizeChanged"
        PreviewKeyDown="PopupWindow_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="local:UiMotion.PressFeedback" Value="True" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="320" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="80" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource PopupButtonCornerRadius}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="1" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Pinned">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="0" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource PopupMutedBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,4" />
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True"
                                   Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                                  Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                                  Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Margin="2,1"
                                                        Background="{DynamicResource PopupButtonBorderBrush}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter Property="Height" Value="8" />
                                <Setter Property="Width" Value="Auto" />
                                <Setter TargetName="PART_Track"
                                        Property="IsDirectionReversed"
                                        Value="False" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="PopupRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="ContentRow" Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="HeaderBarGrid" Grid.Row="0" Background="Transparent"
              MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <local:WindowSizePresetBar x:Name="SizePresetBar"
                                       Visibility="Collapsed"
                                       Grid.Column="0"
                                       Margin="18,0,0,7"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />

            <Border x:Name="ActionBarSurface"
                    Grid.Column="2"
                    Margin="0,0,18,7"
                    Padding="5,4"
                    Visibility="Collapsed"
                    Background="{DynamicResource PopupButtonBrush}"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    CornerRadius="{DynamicResource PopupActionBarCornerRadius}"
                    Effect="{DynamicResource PopupActionBarShadowEffect}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top">
            <StackPanel x:Name="ActionPanel"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock x:Name="ActionStatusText"
                           Margin="7,0,6,0"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource AccentBrush}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="Copied" />
                <Button x:Name="DirectionButton"
                        Visibility="Collapsed"
                        Width="Auto"
                        MinWidth="76"
                        Margin="2,0,2,0"
                        Padding="10,4"
                        Style="{StaticResource ActionButtonStyle}"
                        FontSize="12"
                        FontWeight="Medium"
                        Content="To Chinese"
                        ToolTip="Switch translation language"
                        Click="DirectionButton_Click" />
                <Button x:Name="ExplainButton"
                        Visibility="Collapsed"
                        Width="Auto"
                        MinWidth="62"
                        Margin="2,0,2,0"
                        Padding="9,4"
                        Style="{StaticResource ActionButtonStyle}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="Explain"
                        ToolTip="Explain source text"
                        IsEnabled="False"
                        Click="ExplainButton_Click" />
                <Button x:Name="CodeAnalysisButton"
                        Visibility="Collapsed"
                        Width="Auto"
                        MinWidth="56"
                        Margin="2,0,2,0"
                        Padding="9,4"
                        Style="{StaticResource ActionButtonStyle}"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Content="Code"
                        ToolTip="Analyze selected code"
                        IsEnabled="False"
                        Click="CodeAnalysisButton_Click" />
                <Border Visibility="Collapsed" Margin="3,0,2,0"
                        Padding="2"
                        Background="{DynamicResource PopupBackgroundBrush}"
                        CornerRadius="{DynamicResource PopupButtonCornerRadius}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" Margin="5,0,3,0">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource PopupMutedBrush}"
                                      Data="M8,3H19A2,2 0 0 1 21,5V16A2,2 0 0 1 19,18H17V16H19V5H8V7H6V5A2,2 0 0 1 8,3ZM5,7H14A2,2 0 0 1 16,9V20A2,2 0 0 1 14,22H5A2,2 0 0 1 3,20V9A2,2 0 0 1 5,7ZM5,9V20H14V9H5Z" />
                            </Canvas>
                        </Viewbox>
                        <Button x:Name="CopySourceButton"
                                Style="{StaticResource TextActionButtonStyle}"
                                Content="Source"
                                ToolTip="Copy source"
                                Click="CopySourceButton_Click" />
                        <Button x:Name="CopyTranslationButton"
                                Style="{StaticResource TextActionButtonStyle}"
                                Content="Translation"
                                ToolTip="Copy translation"
                                Click="CopyTranslationButton_Click" />
                    </StackPanel>
                </Border>
                <Button x:Name="EditTranslationButton"
                        Visibility="Collapsed"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="Edit and save correction"
                        Click="EditTranslationButton_Click">
                    <Grid Width="24" Height="24">
                        <Viewbox x:Name="EditTranslationIcon" Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M4,17.25V21H7.75L18.81,9.94L15.06,6.19L4,17.25ZM21.71,7.04C22.1,6.65 22.1,6 21.71,5.63L19.37,3.29C19,2.9 18.35,2.9 17.96,3.29L16.13,5.12L19.88,8.87L21.71,7.04Z" />
                            </Canvas>
                        </Viewbox>
                        <Viewbox x:Name="SaveCorrectionIcon"
                                 Width="20"
                                 Height="20"
                                 Visibility="Collapsed">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Data="M5,12.5 L9.5,17 L19,7" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>

                <Border Padding="3" Margin="0,0,6,0" CornerRadius="10"
                        Background="{DynamicResource PopupBackgroundBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="SourceViewButton" Style="{StaticResource TextActionButtonStyle}"
                                Content="Source" ToolTip="Show source" Click="SourceViewButton_Click" />
                        <Button x:Name="TranslationViewButton" Style="{StaticResource TextActionButtonStyle}"
                                Content="Translation" ToolTip="Show translation" Tag="Selected" Click="TranslationViewButton_Click" />
                    </StackPanel>
                </Border>
                <Button x:Name="PinButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="Keep window"
                        Click="PinButton_Click">
                    <Grid Width="24" Height="24">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M16,9V4L17,3V2H7V3L8,4V9C8,10.66 6.66,12 5,12V14H11V21H13V14H19V12C17.34,12 16,10.66 16,9Z" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
                <Button x:Name="CloseButton"
                        Style="{StaticResource ActionButtonStyle}"
                        ToolTip="Close"
                        Click="CloseButton_Click">
                    <Grid Width="24" Height="24">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Data="M6,6 L18,18 M18,6 L6,18" />
                            </Canvas>
                        </Viewbox>
                    </Grid>
                </Button>
            </StackPanel>
            </Border>
            <local:LiquidGlassRim Grid.Column="2"
                                 Width="{Binding ActualWidth, ElementName=ActionBarSurface}"
                                 Height="{Binding ActualHeight, ElementName=ActionBarSurface}"
                                 Margin="{Binding Margin, ElementName=ActionBarSurface}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Visibility="{Binding Visibility, ElementName=ActionBarSurface}"
                                 CornerRadius="{DynamicResource PopupActionBarCornerRadius}"
                                 IsGlassEnabled="{DynamicResource PopupGlassEnabled}" />
        </Grid>

        <Grid Grid.Row="1">
            <Canvas x:Name="BubbleTailLayer"
                    Panel.ZIndex="0"
                    IsHitTestVisible="False">
                <Path x:Name="BubbleLeftTail"
                      Canvas.Left="2"
                      Canvas.Top="31"
                      Data="M0,0 L18,8 L0,16 Z"
                      Fill="{DynamicResource PopupTailBrush}"
                      Stroke="{DynamicResource PopupTailStrokeBrush}"
                      StrokeThickness="1"
                      StrokeLineJoin="Round"
                      Visibility="Collapsed" />
                <Path x:Name="BubbleRightTail"
                      Canvas.Right="2"
                      Canvas.Top="31"
                      Data="M18,0 L0,8 L18,16 Z"
                      Fill="{DynamicResource PopupTailBrush}"
                      Stroke="{DynamicResource PopupTailStrokeBrush}"
                      StrokeThickness="1"
                      StrokeLineJoin="Round"
                      Visibility="Collapsed" />
            </Canvas>

            <Border x:Name="PopupSurface"
                Panel.ZIndex="1"
                MaxWidth="820"
                MaxHeight="600"
                ClipToBounds="True"
                Padding="22,6,22,20"
                CornerRadius="{DynamicResource PopupSurfaceCornerRadius}"
                Background="{DynamicResource PopupBackgroundBrush}"
                BorderBrush="Transparent"
                BorderThickness="0"
                Effect="{DynamicResource PopupSurfaceShadowEffect}"
                SizeChanged="PopupSurface_SizeChanged">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="BubbleHighlight"
                        Grid.RowSpan="2"
                        IsHitTestVisible="False"
                        Background="{DynamicResource PopupHighlightBrush}"
                        CornerRadius="{DynamicResource PopupSurfaceCornerRadius}"
                        Visibility="Collapsed" />

                <Border x:Name="DragHandle"
                        Grid.Row="0"
                        Height="28"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Panel.ZIndex="60"
                        CornerRadius="14"
                        Cursor="SizeAll"
                        ToolTip="Drag to move"
                        ToolTipService.InitialShowDelay="250"
                        MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border Width="44"
                            Height="4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource PopupMutedBrush}"
                            Opacity="0.38"
                            CornerRadius="2.5" />
                </Border>

            <Grid x:Name="PopupContentGrid"
                  Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="TranslationTextSurface"
                        Background="{DynamicResource PopupTextSurfaceBrush}"
                        CornerRadius="{DynamicResource PopupTextSurfaceCornerRadius}"
                        Padding="{DynamicResource PopupTextSurfacePadding}">
                <Grid>
                <Grid x:Name="TranslationView">
                <StackPanel x:Name="LoadingPanel"
                            MinWidth="150"
                            Margin="0"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingTextBlock"
                               MaxWidth="420"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource PopupTextBrush}"
                               FontSize="13.5"
                               TextWrapping="Wrap"
                               Text="Translating…" />
                </StackPanel>

                <RichTextBox x:Name="TranslationRichTextBox"
                             MinWidth="220"
                             MaxWidth="788"
                             MaxHeight="548"
                             Margin="0"
                             Padding="0"
                             Visibility="Collapsed"
                             Background="Transparent"
                             Foreground="{DynamicResource PopupTextBrush}"
                             BorderThickness="0"
                             FontFamily="{DynamicResource InterfaceFont}"
                             FontSize="16.5"
                             IsReadOnly="True"
                             IsUndoEnabled="False"
                             IsDocumentEnabled="False"
                             IsInactiveSelectionHighlightEnabled="True"
                             Focusable="True"
                             Cursor="IBeam"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             SelectionTextBrush="{DynamicResource AccentTextBrush}"
                             SelectionOpacity="1"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.PanningMode="VerticalOnly"
                             PreviewMouseLeftButtonDown="TranslationRichTextBox_PreviewMouseLeftButtonDown"
                             SelectionChanged="TranslationRichTextBox_SelectionChanged">
                    <RichTextBox.ContextMenu>
                        <ContextMenu FontFamily="{DynamicResource InterfaceFont}"
                                     FontSize="12.5">
                            <MenuItem x:Name="CopySelectionMenuItem"
                                      Header="Copy"
                                      Command="{x:Static ApplicationCommands.Copy}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Separator />
                            <MenuItem x:Name="SelectAllMenuItem"
                                      Header="Select all"
                                      Command="{x:Static ApplicationCommands.SelectAll}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>
                </Grid>
                <RichTextBox x:Name="SourceRichTextBox" Visibility="Collapsed"
                             MinWidth="220" MaxWidth="788" MaxHeight="548" Margin="0" Padding="0"
                             Background="Transparent" Foreground="{DynamicResource PopupTextBrush}"
                             BorderThickness="0" FontFamily="{DynamicResource InterfaceFont}" FontSize="16.5"
                             IsReadOnly="True" IsUndoEnabled="False" IsDocumentEnabled="False"
                             IsInactiveSelectionHighlightEnabled="True" Cursor="IBeam"
                             SelectionBrush="{DynamicResource AccentBrush}"
                             SelectionTextBrush="{DynamicResource AccentTextBrush}" SelectionOpacity="1"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.PanningMode="VerticalOnly">
                    <RichTextBox.ContextMenu>
                        <ContextMenu FontFamily="{DynamicResource InterfaceFont}" FontSize="13">
                            <MenuItem x:Name="CopySourceSelectionMenuItem" Header="Copy" Command="{x:Static ApplicationCommands.Copy}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <MenuItem x:Name="SelectAllSourceMenuItem" Header="Select all" Command="{x:Static ApplicationCommands.SelectAll}"
                                      CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>
                </Grid>
                </Border>

                <Canvas x:Name="SelectionActionLayer"
                        Panel.ZIndex="10"
                        IsHitTestVisible="True">
                    <Button x:Name="SelectionExplainButton"
                            Visibility="Collapsed"
                            Style="{StaticResource TextActionButtonStyle}"
                            Padding="9,3"
                            Focusable="False"
                            Background="{DynamicResource PopupButtonBrush}"
                            Content="Explain"
                            ToolTip="Explain selected translation"
                            Click="SelectionExplainButton_Click" />
                </Canvas>

                <Grid x:Name="ExplanationOverlay"
                      Panel.ZIndex="20"
                      Visibility="Collapsed"
                      Background="{DynamicResource ExplanationSurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="10,8"
                            Background="{DynamicResource ExplanationHeaderBrush}"
                            BorderThickness="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExplanationTitleText"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource PopupTextBrush}"
                                       FontFamily="{DynamicResource InterfaceFont}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Text="AI Explain" />
                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Right"
                                         Orientation="Horizontal">
                                <Button x:Name="ExplanationCopyButton"
                                        Style="{StaticResource TextActionButtonStyle}"
                                        Margin="0"
                                        Content="Copy"
                                        ToolTip="Copy explanation"
                                        IsEnabled="False"
                                        Click="ExplanationCopyButton_Click" />
                                <Button x:Name="ExplanationRecordButton"
                                        Style="{StaticResource TextActionButtonStyle}"
                                        Margin="4,0,0,0"
                                        Content="Record"
                                        ToolTip="Save this explanation to today's Markdown record"
                                        IsEnabled="False"
                                        Click="ExplanationRecordButton_Click" />
                                <Button x:Name="ExplanationRetryButton"
                                        Style="{StaticResource TextActionButtonStyle}"
                                        Margin="4,0,0,0"
                                        Content="Retry"
                                        ToolTip="Retry explanation"
                                        Visibility="Collapsed"
                                        Click="ExplanationRetryButton_Click" />
                                <Button x:Name="ExplanationBackButton"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource TextActionButtonStyle}"
                                        Content="Back"
                                        ToolTip="Back to translation"
                                        Click="ExplanationBackButton_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="ExplanationTextSurface"
                            Grid.Row="1"
                            Margin="12,10"
                            Background="{DynamicResource PopupTextSurfaceBrush}"
                            CornerRadius="{DynamicResource PopupTextSurfaceCornerRadius}"
                            Padding="{DynamicResource PopupTextSurfacePadding}">
                    <Grid>
                        <TextBlock x:Name="ExplanationStatusText"
                                   MaxWidth="520"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource PopupMutedBrush}"
                                   FontFamily="{DynamicResource InterfaceFont}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Text="Analyzing…" />
                        <RichTextBox x:Name="ExplanationRichTextBox"
                                     Margin="0"
                                     Padding="0"
                                     Visibility="Collapsed"
                                     Background="Transparent"
                                     Foreground="{DynamicResource PopupTextBrush}"
                                     BorderThickness="0"
                                     FontFamily="SimHei"
                                     FontSize="16.5"
                                     IsReadOnly="True"
                                     IsUndoEnabled="False"
                                     IsDocumentEnabled="False"
                                     IsInactiveSelectionHighlightEnabled="True"
                                     Focusable="True"
                                     Cursor="IBeam"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     SelectionTextBrush="{DynamicResource AccentTextBrush}"
                                     SelectionOpacity="1"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Disabled"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Top"
                                     ScrollViewer.PanningMode="VerticalOnly">
                            <RichTextBox.ContextMenu>
                                <ContextMenu FontFamily="{DynamicResource InterfaceFont}"
                                             FontSize="12.5">
                                    <MenuItem x:Name="CopyExplanationSelectionMenuItem"
                                              Header="Copy"
                                              Command="{x:Static ApplicationCommands.Copy}"
                                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem x:Name="SelectAllExplanationMenuItem"
                                              Header="Select all"
                                              Command="{x:Static ApplicationCommands.SelectAll}"
                                              CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </RichTextBox.ContextMenu>
                        </RichTextBox>
                    </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="QuestionBar"
                            Grid.Column="0"
                            MaxWidth="520"
                            Margin="8,10,8,0"
                            Padding="9,6"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource QuestionInputBrush}"
                            CornerRadius="14"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="InlineQuestionTextBox"
                                         MinWidth="190"
                                         MinHeight="23"
                                         MaxHeight="72"
                                         Padding="2"
                                         Background="Transparent"
                                         Foreground="{DynamicResource PopupTextBrush}"
                                         BorderThickness="0"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         TextChanged="InlineQuestionTextBox_TextChanged"
                                         PreviewKeyDown="InlineQuestionTextBox_PreviewKeyDown" />
                                <TextBlock x:Name="InlineQuestionPlaceholder"
                                           Margin="3,1,0,0"
                                           VerticalAlignment="Top"
                                           Foreground="{DynamicResource PopupMutedBrush}"
                                           IsHitTestVisible="False"
                                           Text="Ask about this…" />
                            </Grid>
                            <Button x:Name="InlineAskButton"
                                    Grid.Column="1"
                                    MinWidth="48"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource TextActionButtonStyle}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="{DynamicResource AccentTextBrush}"
                                    Content="Ask"
                                    Click="InlineAskButton_Click" />
                        </Grid>
                    </Border>

                    <Button x:Name="DeepSeekChatButton"
                            Grid.Column="1"
                            MinWidth="92"
                            Height="32"
                            Margin="8,10,0,0"
                            Padding="10,4"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource TextActionButtonStyle}"
                            Background="{DynamicResource PopupButtonBrush}"
                            ToolTip="Open DeepSeek quick chat"
                            Click="DeepSeekChatButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontSize="13"
                                       Text="✦" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                       FontWeight="SemiBold"
                                       Text="DeepSeek" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
            </Grid>
            </Border>
            <local:LiquidGlassRim x:Name="GlassSurfaceRim"
                                 Panel.ZIndex="2"
                                 Margin="{Binding Margin, ElementName=PopupSurface}"
                                 MaxWidth="{Binding MaxWidth, ElementName=PopupSurface}"
                                 MaxHeight="{Binding MaxHeight, ElementName=PopupSurface}"
                                 CornerRadius="{DynamicResource PopupSurfaceCornerRadius}"
                                 IsGlassEnabled="{DynamicResource PopupGlassEnabled}" />
        </Grid>
    </Grid>
</Window>
