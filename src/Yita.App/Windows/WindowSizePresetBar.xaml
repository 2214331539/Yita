<UserControl x:Class="Yita.Windows.WindowSizePresetBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Yita.Windows"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="PresetButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0.5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="260" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource PopupButtonCornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource PopupButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome"
                                        Property="Background"
                                        Value="{DynamicResource PopupButtonHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="FontTrackTemplate" TargetType="RepeatButton">
            <Border Height="3"
                    VerticalAlignment="Center"
                    Background="{TemplateBinding Background}"
                    CornerRadius="1.5" />
        </ControlTemplate>

        <Style x:Key="FontThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Ellipse x:Name="ThumbCore"
                                     Width="14"
                                     Height="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource AccentBrush}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbCore" Property="Width" Value="16" />
                                <Setter TargetName="ThumbCore" Property="Height" Value="16" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbCore" Property="Fill" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DirectFontSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Margin="2,0"
                                   VerticalAlignment="Center"
                                   IsDirectionReversed="False"
                                   Maximum="{TemplateBinding Maximum}"
                                   Minimum="{TemplateBinding Minimum}"
                                   Value="{TemplateBinding Value}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource AccentBrush}"
                                                  Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False"
                                                  Template="{StaticResource FontTrackTemplate}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Background="{DynamicResource PopupButtonHoverBrush}"
                                                  Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False"
                                                  Template="{StaticResource FontTrackTemplate}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FontThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
    <Border Padding="4,3"
            Background="{DynamicResource PopupButtonBrush}"
            CornerRadius="{DynamicResource PopupActionBarCornerRadius}"
            Effect="{DynamicResource PopupActionBarShadowEffect}">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="SmallButton"
                    Tag="Small"
                    Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click">
                <Border Width="9"
                        Height="7"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        BorderThickness="1.4"
                        CornerRadius="1" />
            </Button>
            <Button x:Name="MediumButton"
                    Tag="Medium"
                    Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click">
                <Border Width="13"
                        Height="10"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        BorderThickness="1.4"
                        CornerRadius="1.2" />
            </Button>
            <Button x:Name="LargeButton"
                    Tag="Large"
                    Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click">
                <Border Width="17"
                        Height="13"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        BorderThickness="1.4"
                        CornerRadius="1.5" />
            </Button>
            <Button x:Name="WideButton"
                    Tag="Wide"
                    Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click">
                <Border Width="17"
                        Height="9"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        BorderThickness="1.4"
                        CornerRadius="1.5" />
            </Button>
            <Button x:Name="TallButton"
                    Tag="Tall"
                    Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click">
                <Border Width="9"
                        Height="17"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        BorderThickness="1.4"
                        CornerRadius="1.5" />
            </Button>
            <Button x:Name="SquareButton"
                    Tag="Square"
                    Style="{StaticResource PresetButtonStyle}"
                    Click="PresetButton_Click">
                <Border Width="13"
                        Height="13"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        BorderThickness="1.4"
                        CornerRadius="1.5" />
            </Button>

            <Border Width="1"
                    Height="17"
                    Margin="4,0,3,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PopupButtonBorderBrush}" />

            <Grid x:Name="FontSizePanel"
                  Margin="1,0,1,0"
                  VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Margin="0,0,3,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PopupMutedBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Text="A" />
                <Slider x:Name="FontSizeSlider"
                        Grid.Column="1"
                        Width="54"
                        Minimum="12"
                        Maximum="34"
                        Value="16.5"
                        SmallChange="0.5"
                        LargeChange="2"
                        TickFrequency="0.5"
                        IsSnapToTickEnabled="False"
                        Style="{StaticResource DirectFontSliderStyle}"
                        ValueChanged="FontSizeSlider_ValueChanged" />
                <TextBlock x:Name="FontSizeValueText"
                           Grid.Column="2"
                           Width="24"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource PopupMutedBrush}"
                           FontSize="9.5"
                           Text="16.5"
                           TextAlignment="Right" />
            </Grid>
        </StackPanel>
    </Border>
    <local:LiquidGlassRim CornerRadius="{DynamicResource PopupActionBarCornerRadius}"
                         IsGlassEnabled="{DynamicResource PopupGlassEnabled}" />
    </Grid>
</UserControl>
