<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yita.Desktop</AssemblyName>
    <RootNamespace>Yita.Desktop</RootNamespace>
    <ApplicationIcon>Assets\Yita.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Yita.Core\Yita.Core.csproj" />
    <ProjectReference Include="..\Yita.Native.Windows\Yita.Native.Windows.csproj" />
    <ProjectReference Include="..\Yita.Native.Mac\Yita.Native.Mac.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Yita.ico" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="../Yita.App/Assets/AppLogo.png" Link="Assets/AppLogo.png" />
    <AvaloniaResource Include="Assets/Yita.ico" />
    <AvaloniaResource Include="../Yita.App/Assets/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    UI Automation is deliberately compiled as a Windows-only helper process.
    Building the desktop project on Windows builds and places the helper next
    to Yita.Desktop.exe. The condition keeps macOS/Linux builds free of
    WindowsDesktop dependencies.
  -->
  <Target Name="BuildAndCopyWindowsUiAutomationWorker"
          BeforeTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'">
    <MSBuild Projects="..\Yita.Native.Windows.UIA.Worker\Yita.Native.Windows.UIA.Worker.csproj"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration)" />
    <ItemGroup>
      <WindowsUiAutomationWorkerFiles Include="..\Yita.Native.Windows.UIA.Worker\bin\$(Configuration)\net8.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsUiAutomationWorkerFiles)"
          DestinationFiles="@(WindowsUiAutomationWorkerFiles->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
