<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Yita.Desktop.TranslationPopupWindow"
        Width="380" Height="220"
        MinWidth="280" MinHeight="120"
        MaxWidth="720" MaxHeight="520"
        SizeToContent="Manual"
        CanResize="True"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Title="Yita · 翻译"
        SystemDecorations="None"
        Background="Transparent">
  <Border Background="#FFFFFC" BorderBrush="#CFE3DF" BorderThickness="1" CornerRadius="12" Padding="16">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="*,Auto,Auto"
            Background="Transparent"
            PointerPressed="HeaderPointerPressed"
            PointerMoved="HeaderPointerMoved"
            PointerReleased="HeaderPointerReleased"
            PointerCaptureLost="HeaderPointerCaptureLost"
            Cursor="SizeAll">
        <StackPanel Orientation="Horizontal" Spacing="4" Cursor="Arrow">
          <Button x:Name="OriginalButton" Content="原文" Click="OriginalClick" FontSize="13" Padding="10,5" />
          <Button x:Name="TranslatedButton" Content="译文" Click="TranslatedClick" FontSize="13" Padding="10,5" />
        </StackPanel>
        <ToggleButton x:Name="PinButton" Grid.Column="1" Width="30" Height="30" Margin="0,0,4,0"
                      Click="PinClick" ToolTip.Tip="固定窗口" Cursor="Arrow" AutomationProperties.Name="固定窗口">
          <Path Data="M 6,2 L 14,2 L 12,7 L 16,11 L 4,11 L 8,7 Z M 10,11 L 10,18"
                Stroke="#155E63" StrokeThickness="1.5" Width="20" Height="20" />
        </ToggleButton>
        <Button Grid.Column="2" Width="30" Height="30" Click="CloseClick" ToolTip.Tip="关闭翻译"
                Cursor="Arrow" AutomationProperties.Name="关闭翻译">
          <Path Data="M 4,4 L 16,16 M 16,4 L 4,16" Stroke="#536C6D" StrokeThickness="1.5" Width="20" Height="20" />
        </Button>
      </Grid>
      <ScrollViewer x:Name="ReadingScroll" Grid.Row="1" Margin="0,14,0,4" HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock x:Name="TranslationText" Text="正在读取选区…" TextWrapping="Wrap" FontSize="16" Foreground="#173F43" />
      </ScrollViewer>
      <Border Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="BottomRightCorner" PointerPressed="ResizePointerPressed">
        <Path Data="M 5,12 L 12,5 M 9,12 L 12,9" Stroke="#9EB9B6" StrokeThickness="1.5" />
      </Border>
    </Grid>
  </Border>
</Window>
