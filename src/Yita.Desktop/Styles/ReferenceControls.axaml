<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Margin" Value="0,0,0,7" /><Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /><Setter Property="LineHeight" Value="19" />
  </Style>
  <Style Selector="TextBlock.supporting">
    <Setter Property="FontSize" Value="12.5" /><Setter Property="LineHeight" Value="20" />
    <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="46" /><Setter Property="Padding" Value="23,12" />
    <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="CornerRadius" Value="10" />
    <Setter Property="Background" Value="{DynamicResource AppFieldBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppFieldBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /><Setter Property="CaretBrush" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="SelectionForegroundBrush" Value="{DynamicResource AccentTextBrush}" />
  </Style>
  <Style Selector="TextBox:focus-within /template/ Border#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox, AutoCompleteBox">
    <Setter Property="MinHeight" Value="40" /><Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource AppFieldBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppFieldBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="10,6" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
  </Style>
  <Style Selector="AutoCompleteBox /template/ TextBox"><Setter Property="MinHeight" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="23,9,32,9" /></Style>
  <Style Selector="Button.model-arrow"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Cursor" Value="Hand" /></Style>
  <Style Selector="Button.secondary, Button.primary">
    <Setter Property="RenderTransform" Value="scale(1)" /><Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PressMotionDuration}" Easing="CubicEaseOut" /></Transitions></Setter>
    <Setter Property="MinWidth" Value="84" /><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="14,6" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource AppFieldBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppFieldBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource AppHoverBrush}" /></Style>
  <Style Selector="Button.secondary:pressed /template/ Border#Chrome"><Setter Property="Background" Value="{DynamicResource AppPressedBrush}" /></Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ Border#Chrome">
    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ Border#Chrome"><Setter Property="Opacity" Value="0.82" /></Style>
  <Style Selector="Button.primary:pressed, Button.secondary:pressed"><Setter Property="RenderTransform" Value="{DynamicResource PressedScale}" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.46" /></Style>
  <Style Selector="ToggleSwitch.switch">
    <Setter Property="Width" Value="46" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="46" />
    <Setter Property="MinHeight" Value="28" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="Track" Width="46" Height="28" Background="{DynamicResource AppFieldBorderBrush}" CornerRadius="14">
          <Grid x:Name="PART_MovingKnobs">
            <Ellipse x:Name="Knob" Width="22" Height="22" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource SwitchKnobBrush}" RenderTransform="translateX(0px)">
              <Ellipse.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource SwitchMotionDuration}" Easing="CubicEaseOut" /></Transitions></Ellipse.Transitions>
            </Ellipse>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleSwitch.switch:checked /template/ Border#Track"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ToggleSwitch.switch:checked /template/ Ellipse#Knob"><Setter Property="RenderTransform" Value="translateX(18px)" /></Style>
  <Style Selector="ToggleSwitch.switch:pointerover /template/ Border#Track"><Setter Property="Opacity" Value="0.86" /></Style>
  <Style Selector="ToggleSwitch.switch:disabled /template/ Border#Track"><Setter Property="Opacity" Value="0.45" /></Style>
  <Style Selector="ListBox.settings-navigation">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="1" />
  </Style>
  <Style Selector="ListBox.settings-navigation ListBoxItem">
    <Setter Property="Padding" Value="14,11" /><Setter Property="Margin" Value="6,3" /><Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource AppMutedTextBrush}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="NavigationChrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" CornerRadius="9">
          <TextBlock Text="{TemplateBinding Content}" LineHeight="20" TextWrapping="Wrap" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.settings-navigation ListBoxItem:pointerover /template/ Border#NavigationChrome"><Setter Property="Background" Value="{DynamicResource AppHoverBrush}" /></Style>
  <Style Selector="ListBox.settings-navigation ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="ListBox.settings-navigation ListBoxItem:selected /template/ Border#NavigationChrome"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="ScrollBar:vertical"><Setter Property="Width" Value="9" /></Style>
  <Style Selector="ScrollBar:horizontal"><Setter Property="Height" Value="9" /></Style>
  <Style Selector="Slider.font-size"><Setter Property="Height" Value="30" /></Style>
  <Style Selector="Button.reading-action, ToggleButton.reading-action">
    <Setter Property="RenderTransform" Value="scale(1)" /><Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="{DynamicResource PressMotionDuration}" Easing="CubicEaseOut" /></Transitions></Setter>
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="0" />
    <Setter Property="MinWidth" Value="0" /><Setter Property="Margin" Value="2,0,0,0" /><Setter Property="Padding" Value="4" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="ReadingChrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PopupButtonCornerRadius}" Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.text-action"><Setter Property="Width" Value="NaN" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="58" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="7,3" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="ComboBox.popup-language">
    <Setter Property="Width" Value="108" /><Setter Property="MinHeight" Value="28" /><Setter Property="Height" Value="28" />
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" /><Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
    <Setter Property="Padding" Value="10,3,6,3" /><Setter Property="Cursor" Value="Hand" /><Setter Property="MaxDropDownHeight" Value="200" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border x:Name="LanguageChrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PopupButtonCornerRadius}">
          <Grid ColumnDefinitions="*,24">
            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
            <Path Grid.Column="1" Width="9" Height="5" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Data="M0,0 L4.5,4.5 L9,0" Stroke="{DynamicResource PopupMutedBrush}" StrokeThickness="1.5" StrokeLineCap="Round" />
            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="LanguageChrome"
                   MinWidth="160" MaxHeight="{TemplateBinding MaxDropDownHeight}" Placement="BottomEdgeAlignedLeft"
                   VerticalOffset="6" IsLightDismissEnabled="True" InheritsTransform="True" WindowManagerAddShadowHint="False">
              <Border Padding="5" Background="{DynamicResource ExplanationSurfaceBrush}" BorderBrush="{DynamicResource PopupButtonBorderBrush}"
                      BorderThickness="1" CornerRadius="{DynamicResource PopupActionBarCornerRadius}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter x:Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ComboBox.popup-language:pointerover /template/ Border#LanguageChrome, ComboBox.popup-language:dropdownopen /template/ Border#LanguageChrome">
    <Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" />
  </Style>
  <Style Selector="ComboBox.popup-language:focus-visible /template/ Border#LanguageChrome">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox.popup-language ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" /><Setter Property="Padding" Value="10,7" /><Setter Property="CornerRadius" Value="{DynamicResource PopupButtonCornerRadius}" />
  </Style>
  <Style Selector="ComboBox.popup-language ComboBoxItem:pointerover /template/ ContentPresenter, ComboBox.popup-language ComboBoxItem:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
  </Style>
  <Style Selector="ComboBox.popup-language ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource PopupTextBrush}" />
  </Style>
  <Style Selector="Button.qa-action"><Setter Property="Width" Value="NaN" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="34" /><Setter Property="Padding" Value="8,3" /><Setter Property="FontSize" Value="11.5" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="Button.size-preset"><Setter Property="Width" Value="25" /><Setter Property="Height" Value="28" /><Setter Property="Margin" Value="0.5,0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="Slider.direct-font-size">
    <Setter Property="Cursor" Value="SizeWestEast" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid Height="22" Background="Transparent">
          <Track x:Name="PART_Track" Margin="2,0" Height="18" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}" VerticalAlignment="Center" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value, Mode=TwoWay}">
            <Track.DecreaseButton><RepeatButton x:Name="PART_DecreaseButton" Focusable="False" Background="{DynamicResource AccentBrush}" /></Track.DecreaseButton>
            <Track.IncreaseButton><RepeatButton x:Name="PART_IncreaseButton" Focusable="False" Background="{DynamicResource PopupButtonHoverBrush}" /></Track.IncreaseButton>
            <Track.Thumb><Thumb Width="14" Height="18" /></Track.Thumb>
          </Track>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Slider.direct-font-size /template/ RepeatButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Template"><ControlTemplate><Border Height="3" VerticalAlignment="Center" Background="{TemplateBinding Background}" CornerRadius="1.5" /></ControlTemplate></Setter>
  </Style>
  <Style Selector="Slider.direct-font-size /template/ Thumb">
    <Setter Property="Template"><ControlTemplate><Ellipse x:Name="FontThumb" Width="14" Height="14" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" /></ControlTemplate></Setter>
  </Style>
  <Style Selector="Slider.direct-font-size /template/ Thumb:pointerover /template/ Ellipse#FontThumb"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /></Style>
  <Style Selector="Slider.direct-font-size /template/ Thumb:pressed /template/ Ellipse#FontThumb"><Setter Property="Fill" Value="{DynamicResource AccentLightBrush}" /></Style>
  <Style Selector="TextBox.qa-input /template/ TextBlock#PART_Watermark"><Setter Property="Foreground" Value="{DynamicResource PopupMutedBrush}" /><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="Button.reading-action:pointerover /template/ Border#ReadingChrome, ToggleButton.reading-action:pointerover /template/ Border#ReadingChrome"><Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" /></Style>
  <Style Selector="Button.reading-action:pressed, ToggleButton.reading-action:pressed"><Setter Property="RenderTransform" Value="{DynamicResource PressedScale}" /><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></Style>
  <Style Selector="Button.reading-action:pressed /template/ Border#ReadingChrome, ToggleButton.reading-action:pressed /template/ Border#ReadingChrome"><Setter Property="Background" Value="{DynamicResource AccentLightBrush}" /></Style>
  <Style Selector="Button.reading-action.selected /template/ Border#ReadingChrome"><Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" /></Style>
  <Style Selector="ToggleButton.reading-action:checked /template/ Border#ReadingChrome"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Border.drag-handle:pointerover"><Setter Property="Background" Value="{DynamicResource PopupButtonHoverBrush}" /></Style>
  <Style Selector="ToolTip"><Setter Property="FontFamily" Value="{DynamicResource InterfaceFont}" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="7,4" /></Style>
  <Style Selector="Button.tray-command">
    <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="4,4" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" /><Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Button.tray-command:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource AppHoverBrush}" /></Style>
</Styles>
